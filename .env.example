PROJECT_NAME=Life OS
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:19006
BACKEND_CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|0\.0\.0\.0|192\.168\.\d{1,3}\.\d{1,3}|10\.\d{1,3}\.\d{1,3}\.\d{1,3}|172\.(1[6-9]|2\d|3[0-1])\.\d{1,3}\.\d{1,3})(:\d+)?$

POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=life_os
POSTGRES_USER=life_os
POSTGRES_PASSWORD=life_os

REDIS_URL=redis://redis:6379/0

WEATHER_AGENT_DEFAULT_LATITUDE=48.8566
WEATHER_AGENT_DEFAULT_LONGITUDE=2.3522
WEATHER_AGENT_DEFAULT_LABEL=Paris, France
NEWS_AGENT_DEFAULT_TOPIC=technology
GITHUB_DEFAULT_OWNER=
